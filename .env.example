# Nexus Flow - Configuração
# Copie este arquivo para .env e preencha suas chaves

# === TELEGRAM (opcional - remova ou deixe vazio para desabilitar) ===
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=123456789

# === DISCORD (opcional - remova ou deixe vazio para desabilitar) ===
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
DISCORD_COMMAND_PREFIX=!

# === OBRIGATÓRIO: Pelo menos um LLM ===
GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# === OPCIONAL: Configurações ===
ACTIVE_LLM=gemini            # gemini | deepseek | openai
TRANSCRIPTION_MODE=openai    # local | openai
LOG_LEVEL=info               # error | warn | info | debug

# === OPCIONAL: Ajustes do Agente ===
AGENT_MAX_HISTORY=20
AGENT_MAX_TOKENS=2048
AGENT_TEMPERATURE=0.7

# === OPCIONAL: Segurança ===
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
MAX_FILE_SIZE=10485760       # 10MB
