{
  "name": "nexus-flow",
  "version": "1.0.0",
  "description": "Nexus Flow - Multi-Platform Personal AI Agent (Telegram + Discord)",
  "author": "Nexus Flow Team",
  "license": "MIT",
  "keywords": ["ai", "agent", "telegram", "discord", "gemini", "openai", "deepseek", "whisper"],
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist temp logs data",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "telegraf": "^4.16.3",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "better-sqlite3": "^11.3.0",
    "@google/generative-ai": "^0.21.0",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0",
    "xlsx": "^0.18.5",
    "chokidar": "^4.0.1",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "rimraf": "^6.0.1",
    "@types/node": "^22.9.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/pdf-parse": "^1.1.4",
    "@types/mammoth": "^0.0.37"
  }
}